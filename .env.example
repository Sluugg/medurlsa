# Jellyfin server URL (no trailing slash)
JELLYFIN_URL=http://your-jellyfin-host:8096

# API key from a dedicated Jellyfin service account (Dashboard > API Keys)
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Admin portal password — set something strong
ADMIN_TOKEN=change_this_to_a_strong_secret

# Full public URL of this app (used when generating shareable links)
PUBLIC_BASE_URL=https://your-domain.com

# Path to the SQLite database file (relative to project root or absolute)
DB_PATH=data/links.db
