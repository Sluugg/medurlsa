# Jellyfin server URL (no trailing slash)
JELLYFIN_URL=http://your-jellyfin-host:8096

# API key from a dedicated Jellyfin service account (Dashboard > API Keys)
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Admin portal password — set something strong
ADMIN_TOKEN=change_this_to_a_strong_secret

# Full public URL of this app (used when generating shareable links)
PUBLIC_BASE_URL=https://your-domain.com

# Path to the SQLite database file (relative to project root or absolute)
DB_PATH=data/links.db

# Directory containing background images/videos (relative to project root or absolute)
BACKGROUNDS_DIR=backgrounds

# Character length of newly generated share link IDs. Must be between 8 and 16.
# Only affects new links — existing ones keep working at their current length.
LINK_ID_LENGTH=12

# Basic per-IP rate limiting for the public endpoints that could otherwise be
# used to brute-force guess link IDs (register, cover art) — at most
# RATE_LIMIT_MAX_REQUESTS requests per IP within a rolling RATE_LIMIT_WINDOW_SECONDS window.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional, for local development only — do not set this in production.
# Enables CORS for localhost:5173/:80, needed only if the frontend dev server
# (npm run dev) talks to the backend directly instead of through Vite's /api
# proxy (frontend/vite.config.js). Any non-empty value enables it.
# DEV_MODE=true
